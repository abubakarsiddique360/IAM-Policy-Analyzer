{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBuildArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::build-artifacts", "arn:aws:s3:::build-artifacts/*"],
      "Condition": { "StringEquals": { "aws:PrincipalOrgID": "o-example" } }
    },
    {
      "Sid": "PassOnlyDeployRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111122223333:role/deploy-role",
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    },
    {
      "Sid": "DecryptOnlyFromCorp",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-west-1:111122223333:key/demo-key",
      "Condition": { "IpAddress": { "aws:SourceIp": "203.0.113.0/24" } }
    },
    {
      "Sid": "BlockProductionDeletes",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteBucket"],
      "Resource": ["arn:aws:s3:::production-*", "arn:aws:s3:::production-*/*"]
    }
  ]
}
